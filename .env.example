# -----------------------------------------------------------------------------
# The Lenny Growth Assistant - Environment Configuration
# -----------------------------------------------------------------------------

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection
# For PostgreSQL with pgvector (used in Docker Compose):
DATABASE_URL=postgresql+asyncpg://postgres:password123@db:5432/lenny_assistant
# For Local Development with Local Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant
# For Zero-Dependency Resilient Fallback (SQLite + in-memory vector search):
# DATABASE_URL=sqlite+aiosqlite:///./lenny_assistant.db

# LLM Providers Configuration
# Default provider can be 'ollama', 'claude', or 'openai'
DEFAULT_PROVIDER=ollama

# Local LLM (Ollama)
# When running on host machine: http://localhost:11434
# When running inside Docker on Mac/Windows: http://host.docker.internal:11434
# When running inside Docker on Linux: http://172.17.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud LLM Providers (Optional for cloud toggle)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Vector Search Parameters
SIMILARITY_THRESHOLD=0.60
TOP_K_RETRIEVAL=5

# Frontend Configuration
VITE_API_URL=http://localhost:8000
